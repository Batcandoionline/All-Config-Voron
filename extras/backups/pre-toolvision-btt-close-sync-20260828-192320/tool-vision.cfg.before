    RESPOND TYPE=command MSG="action:prompt_text Nozzle: {tv.calibration_temperature|round(1)} C | Bed: {bed_text} | Estimate: {(((tv.last_duration_seconds / 60.0)|round(1)) ~ ' min from latest run') if tv.last_result_mode == 'XYZ' and tv.last_result_method == 'switch' and tv.last_duration_seconds else 'no comparable run yet'}"
    RESPOND TYPE=command MSG="action:prompt_text Report only - candidate XYZ relative to T{tv.reference_tool}; no offset will be applied"
