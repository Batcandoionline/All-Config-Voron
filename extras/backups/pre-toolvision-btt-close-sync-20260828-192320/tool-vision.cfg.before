[gcode_macro _TOOL_VISION_UI_SETUP_STATUS]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin ToolVision readiness"
    RESPOND TYPE=command MSG="action:prompt_text Camera connected: {tv.camera_connected} | Station: {tv.camera_station_ready} | Detector: {tv.camera_profile_ready} | Transform: {tv.camera_transform_ready} | Stale: {tv.camera_stale_reason|default('no', true)}"
    RESPOND TYPE=command MSG="action:prompt_text Physical switch: {tv.switch_ready} | Cartographer Touch: {tv.cartographer_touch_ready} | Tools: {tv.tool_numbers|join(', ')} | Reference: T{tv.reference_tool}"
    RESPOND TYPE=command MSG="action:prompt_text Nozzle calibration: {tv.calibration_temperature|round(1)} C | Bed evidence: {tv.bed.stability} | Report only"
    RESPOND TYPE=command MSG="action:prompt_button Refresh host status in console|_TOOL_VISION_UI_RUN ACTION=STATUS|info"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_SETUP|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_ADVANCED]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin ToolVision Advanced"
    RESPOND TYPE=command MSG="action:prompt_text SAFE_Z, camera selector/URL, timeout and detector/transform overrides remain cfg/console-only because standard action prompts have no safe numeric input control. Normal setup should not require them."
    RESPOND TYPE=command MSG="action:prompt_button Console status|_TOOL_VISION_UI_RUN ACTION=STATUS|info"
    RESPOND TYPE=command MSG="action:prompt_button Console report/history|_TOOL_VISION_UI_RUN ACTION=HISTORY|info"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_SETUP|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_RUN]
gcode:
  {% set tv = printer.tool_vision %}
  {% set action = params.ACTION|default('')|upper %}
  {% set index = params.INDEX|default(-1)|int %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    # A queued/stale UI action must not emit gcode:command_error because some
    # toolchangers clear active state on that global event.
    RESPOND TYPE=echo MSG="ToolVision action ignored while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision action ignored because another ToolVision operation is active."
  {% else %}
    {% if action == "STATUS" %}
      TOOL_VISION_STATUS
    {% elif action == "HISTORY" %}
      TOOL_VISION_REPORT
      TOOL_VISION_HISTORY
    {% elif action == "CHOOSE_XY" %}
      {% if tv.camera_ready %}
        _TOOL_VISION_UI_CONFIRM_XY
      {% else %}
        _TOOL_VISION_UI_CAMERA_SETUP
      {% endif %}
    {% elif action == "CHOOSE_Z_SWITCH" %}
      TOOL_VISION_SELECT_Z METHOD=SWITCH
      {% if tv.switch_ready %}
        _TOOL_VISION_UI_CONFIRM_Z_SWITCH
      {% else %}
        _TOOL_VISION_UI_CONFIRM_SWITCH
      {% endif %}
    {% elif action == "CHOOSE_Z_CARTOGRAPHER" %}
      TOOL_VISION_SELECT_Z METHOD=CARTOGRAPHER_TOUCH
      {% if tv.cartographer_touch_ready %}
        _TOOL_VISION_UI_CONFIRM_Z_CARTOGRAPHER
      {% else %}
        _TOOL_VISION_UI_CONFIRM_CARTOGRAPHER
      {% endif %}
    {% elif action == "CHOOSE_XYZ_SWITCH" %}
      TOOL_VISION_SELECT_Z METHOD=SWITCH
      {% if not tv.camera_ready %}
        _TOOL_VISION_UI_CAMERA_SETUP
      {% elif tv.switch_ready %}
        _TOOL_VISION_UI_CONFIRM_XYZ_SWITCH
      {% else %}
        _TOOL_VISION_UI_CONFIRM_SWITCH
      {% endif %}
    {% elif action == "CHOOSE_XYZ_CARTOGRAPHER" %}
      TOOL_VISION_SELECT_Z METHOD=CARTOGRAPHER_TOUCH
      {% if not tv.camera_ready %}
        _TOOL_VISION_UI_CAMERA_SETUP
      {% elif tv.cartographer_touch_ready %}
        _TOOL_VISION_UI_CONFIRM_XYZ_CARTOGRAPHER
      {% else %}
        _TOOL_VISION_UI_CONFIRM_CARTOGRAPHER
      {% endif %}
    {% elif action == "CAMERA_DISCOVER" %}
      TOOL_VISION_CAMERA_DISCOVER
      _TOOL_VISION_UI_CAMERA_SETUP
    {% elif action == "CAMERA_SELECT" %}
      TOOL_VISION_CAMERA_SELECT INDEX={index}
      _TOOL_VISION_UI_CAMERA_SETUP
    {% elif action == "CAMERA_PREVIEW" %}
      TOOL_VISION_CAMERA_PREVIEW
      _TOOL_VISION_UI_CAMERA_SETUP
    {% elif action == "CAMERA_STATION" %}
      TOOL_VISION_CAMERA_STATION
      _TOOL_VISION_UI_CAMERA_SETUP
    {% elif action == "CAMERA_LEARN" %}
      TOOL_VISION_SETUP_CAMERA FROM_STATION=1 VERBOSITY=NORMAL
      _TOOL_VISION_UI_CAMERA_SETUP
    {% elif action == "CAMERA_TEST" %}
      TOOL_VISION_CAMERA_TEST
      _TOOL_VISION_UI_CAMERA_SETUP
    {% elif action == "SETUP_SWITCH" %}
      TOOL_VISION_SETUP_Z METHOD=SWITCH
      _TOOL_VISION_UI_Z_SETUP
    {% elif action == "CHECK_SWITCH" %}
      TOOL_VISION_CHECK_Z METHOD=SWITCH
      _TOOL_VISION_UI_Z_SETUP
    {% elif action == "SETUP_CARTOGRAPHER" %}
      TOOL_VISION_SETUP_Z METHOD=CARTOGRAPHER_TOUCH
      _TOOL_VISION_UI_Z_SETUP
    {% elif action == "CHECK_CARTOGRAPHER" %}
      TOOL_VISION_CHECK_Z METHOD=CARTOGRAPHER_TOUCH
      _TOOL_VISION_UI_Z_SETUP
    {% elif action == "CALIBRATE_XY" %}
      {% if tv.camera_ready %}
        TOOL_VISION_CALIBRATE MODE=XY HOME=1 VERBOSITY=QUIET
        _TOOL_VISION_UI_RESULTS
      {% else %}
        _TOOL_VISION_UI_CAMERA_SETUP
      {% endif %}
    {% elif action == "CALIBRATE_Z_SWITCH" %}
      {% if tv.switch_ready %}
        TOOL_VISION_CALIBRATE MODE=Z METHOD=SWITCH HOME=1 VERBOSITY=QUIET
        _TOOL_VISION_UI_RESULTS
      {% else %}
        _TOOL_VISION_UI_CONFIRM_SWITCH
      {% endif %}
    {% elif action == "CALIBRATE_Z_CARTOGRAPHER" %}
      {% if tv.cartographer_touch_ready %}
        TOOL_VISION_CALIBRATE MODE=Z METHOD=CARTOGRAPHER_TOUCH HOME=1 VERBOSITY=QUIET
        _TOOL_VISION_UI_RESULTS
      {% else %}
        _TOOL_VISION_UI_CONFIRM_CARTOGRAPHER
      {% endif %}
    {% elif action == "CALIBRATE_XYZ_SWITCH" %}
      {% if not tv.camera_ready %}
        _TOOL_VISION_UI_CAMERA_SETUP
      {% elif tv.switch_ready %}
        TOOL_VISION_CALIBRATE MODE=XYZ METHOD=SWITCH HOME=1 VERBOSITY=QUIET
        _TOOL_VISION_UI_RESULTS
      {% else %}
        _TOOL_VISION_UI_CONFIRM_SWITCH
      {% endif %}
    {% elif action == "CALIBRATE_XYZ_CARTOGRAPHER" %}
      {% if not tv.camera_ready %}
        _TOOL_VISION_UI_CAMERA_SETUP
      {% elif tv.cartographer_touch_ready %}
        TOOL_VISION_CALIBRATE MODE=XYZ METHOD=CARTOGRAPHER_TOUCH HOME=1 VERBOSITY=QUIET
        _TOOL_VISION_UI_RESULTS
      {% else %}
        _TOOL_VISION_UI_CONFIRM_CARTOGRAPHER
      {% endif %}
    {% else %}
      {action_raise_error("Unknown ToolVision panel action")}
    {% endif %}
  {% endif %}
