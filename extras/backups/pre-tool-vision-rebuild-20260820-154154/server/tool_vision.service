[Unit]
Description=Tool Vision - OpenCV Nozzle Detection Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/printer_data/config/Voron 5 Tool/extras/Tool-Vision/server
ExecStart=/home/pi/tool-vision-env/bin/python vision_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
