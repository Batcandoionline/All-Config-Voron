gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set current = "Physical switch" if tv.z_method == "switch" else ("Cartographer Touch" if tv.z_method == "cartographer_touch" else "not selected") %}
    RESPOND TYPE=command MSG="action:prompt_begin Teach Cartographer Touch"
    RESPOND TYPE=command MSG="action:prompt_text Current method -> New method: {current} -> Cartographer Touch. Requires the current plugin, saved Touch model, bed_mesh zero reference and reviewed clearance for every tool."
    RESPOND TYPE=command MSG="action:prompt_footer_button Teach Cartographer|_TOOL_VISION_UI_RUN ACTION=SETUP_CARTOGRAPHER|error"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
