# ToolVision — report-only XYZ calibration with one visible UI control
#
# Add only `[include tool_vision.cfg]` to the config that contains printer.cfg.
# Standard Mainsail setups already load `[respond]` through client.cfg. If yours
# does not, add one `[respond]` section elsewhere; never add a duplicate.
#
# Routine workflow:
#   1. Open TOOL_VISION; every routine/setup shortcut is on the first screen.
#   2. Z/XYZ buttons name their sensor explicitly, then show one safety confirm.
#   3. Review Latest results. ToolVision never writes production offsets.
#
# Camera/sensor stations, detector profile, transform, rotation, pixel scale and
# tool list are taught/discovered state, not normal cfg inputs. Do not enable
# [axiscope] or [tools_calibrate] sections at the same time.

[tool_vision]
# Set pin only when using the physical-switch Z method. Inversion/pull-up follow
# normal Klipper pin syntax. Verify it with QUERY_ENDSTOPS before first probing.
# Switch mode also needs tools_calibrate.py from klipper-toolchanger installed;
# the [tools_calibrate] section itself must remain disabled.
pin: ^PF2

# Normally omit both camera fields. ToolVision discovers enabled webcams through
# Moonraker. When several cameras exist, the setup wizard asks for a choice.
# camera_name: nozzle

# Use an explicit source only when the camera is not registered in Moonraker.
# Accepted examples: snapshot/MJPEG/RTSP URL, /dev/video0, or OpenCV index 0.
# camera_source: http://127.0.0.1:8080/?action=snapshot

# Routine calibration temperature. The default follows the 150 C Axiscope/
# Cartographer-compatible workflow. TEMP=0 remains an explicit cold-run override.
# calibration_temperature: 150

# Rare compatibility/path overrides; leave commented on normal installations.
# reference_tool: 0
# server_url: http://127.0.0.1:8085
# moonraker_url: http://127.0.0.1:7125
# tool_select_command: T{tool}
# State/result files default to the directory containing the main printer.cfg.
# state_file: /absolute/path/to/tool_vision_state.json
# result_file: /absolute/path/to/tool_vision_results.json
state_file: ~/printer_data/config/Generated-Data/ToolVision/state.json
result_file: ~/printer_data/config/Generated-Data/ToolVision/results.json

# Optional machine-specific validation gates. Do not copy limits from another
# printer. Missing limits keep a successful measurement at WARNING.
# max_reference_xy_drift: <limit from your XY repeatability study>
# max_reference_z_drift: <limit from your Z repeatability study>
# max_transform_rms: <held-out RMS limit from your camera corpus/HIL>
# max_transform_max_error: <held-out maximum limit from your camera corpus/HIL>
# max_xy_uncertainty: <limit from your camera corpus/HIL>

# Advanced bed evidence policy. ToolVision never heats the bed. With no
# tolerance, bed stability is recorded as not_evaluated. A measured per-machine
# tolerance may warn or block an unstable run.
# bed_stability_tolerance: <C from your machine study>
# bed_unstable_policy: warn

# Optional machine-specific hooks: start_gcode, before_tool_gcode,
# after_select_gcode, after_tool_gcode, finish_gcode, abort_gcode.
# after_select_gcode is the place for a reviewed nozzle scrubber path.
# after_select_gcode:
#   CLEAN_NOZZLE TEMP=150

# Optional failure recovery for toolchangers that clear active-tool state after
# a nested G-code error. Initialization may move hardware; configure this only
# after machine-specific review/HIL proves it safe at failure positions.
# toolchanger_recovery_gcode:
#   <reviewed toolchanger recovery command>
toolchanger_recovery_gcode:
  INITIALIZE_TOOLCHANGER

# Advanced clearance overrides remain available from the console:
#   TOOL_VISION_CAMERA_STATION SAFE_Z=25
#   TOOL_VISION_SETUP_CAMERA SAFE_Z=25
#   TOOL_VISION_SETUP_Z METHOD=SWITCH SAFE_Z=25
#   TOOL_VISION_SETUP_Z METHOD=CARTOGRAPHER SAFE_Z=25

[gcode_macro TOOL_VISION]
description: Open the ToolVision report-only XYZ calibration panel
gcode:
  _TOOL_VISION_UI_MAIN

[gcode_macro _TOOL_VISION_UI_CLOSE]
gcode:
  # One idempotent protocol action; no nested RESPOND payload.
  RESPOND TYPE=command MSG="action:prompt_end"

[gcode_macro _TOOL_VISION_UI_MAIN]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set xy_label = "Ready" if tv.camera_ready else "Camera setup required" %}
    {% set switch_label = "Ready" if tv.switch_ready else "Needs setup" %}
    {% set cartographer_label = "Ready" if tv.cartographer_touch_ready else "Needs setup" %}
    RESPOND TYPE=command MSG="action:prompt_begin ToolVision XYZ calibration"
    RESPOND TYPE=command MSG="action:prompt_text ToolVision {tv.version} | Report only - no printer offset is changed"
    RESPOND TYPE=command MSG="action:prompt_text Camera XY: {xy_label} | Cartographer: {cartographer_label} | Switch: {switch_label}"
    RESPOND TYPE=command MSG="action:prompt_button Teach Physical switch|_TOOL_VISION_UI_CONFIRM_SWITCH|warning"
    RESPOND TYPE=command MSG="action:prompt_button Teach camera position safely|_TOOL_VISION_UI_CONFIRM_CAMERA_STATION|warning"
    RESPOND TYPE=command MSG="action:prompt_button Measure Z - Cartographer Touch|_TOOL_VISION_UI_RUN ACTION=CHOOSE_Z_CARTOGRAPHER|primary"
    RESPOND TYPE=command MSG="action:prompt_button Measure Z - Physical switch|_TOOL_VISION_UI_RUN ACTION=CHOOSE_Z_SWITCH|warning"
    RESPOND TYPE=command MSG="action:prompt_button Measure XY - Camera|_TOOL_VISION_UI_RUN ACTION=CHOOSE_XY|primary"
    RESPOND TYPE=command MSG="action:prompt_button Measure XYZ - Camera + Cartographer Touch|_TOOL_VISION_UI_RUN ACTION=CHOOSE_XYZ_CARTOGRAPHER|primary"
    RESPOND TYPE=command MSG="action:prompt_button Measure XYZ - Camera + Physical switch|_TOOL_VISION_UI_RUN ACTION=CHOOSE_XYZ_SWITCH|warning"
    RESPOND TYPE=command MSG="action:prompt_button Latest results|_TOOL_VISION_UI_RESULTS|info"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_Z_METHOD]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set switch = "Ready" if tv.switch_ready else "Needs setup" %}
    {% set carto = "Ready" if tv.cartographer_touch_ready else "Needs setup" %}
    RESPOND TYPE=command MSG="action:prompt_begin Choose Z sensor"
    RESPOND TYPE=command MSG="action:prompt_text Choose explicitly for this run | Last choice: {tv.ui_z_method}"
    RESPOND TYPE=command MSG="action:prompt_button Cartographer Touch - Recommended - {carto}|_TOOL_VISION_UI_RUN ACTION=CHOOSE_Z_CARTOGRAPHER|primary"
    RESPOND TYPE=command MSG="action:prompt_button Physical switch - Cross-check - {switch}|_TOOL_VISION_UI_RUN ACTION=CHOOSE_Z_SWITCH|warning"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_XYZ_METHOD]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set switch = "Ready" if tv.switch_ready else "Needs setup" %}
    {% set carto = "Ready" if tv.cartographer_touch_ready else "Needs setup" %}
    {% set camera = "Ready" if tv.camera_ready else "Camera setup required" %}
    RESPOND TYPE=command MSG="action:prompt_begin Choose XYZ Z sensor"
    RESPOND TYPE=command MSG="action:prompt_text Camera XY: {camera} | Choose the Z sensor explicitly"
    RESPOND TYPE=command MSG="action:prompt_button Camera + Cartographer Touch - {carto}|_TOOL_VISION_UI_RUN ACTION=CHOOSE_XYZ_CARTOGRAPHER|primary"
    RESPOND TYPE=command MSG="action:prompt_button Camera + Physical switch - {switch}|_TOOL_VISION_UI_RUN ACTION=CHOOSE_XYZ_SWITCH|warning"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CONFIRM_XY]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set bed = tv.bed %}
    {% set bed_text = ((bed.actual_c|round(1)) ~ '/' ~ (bed.target_c|round(1)) ~ ' C - ' ~ bed.stability) if bed.available else 'unavailable' %}
    {% set estimate = ((tv.last_duration_seconds / 60.0)|round(1) ~ ' min from latest run') if tv.last_result_mode == 'XY' and tv.last_duration_seconds else 'no comparable run yet' %}
    RESPOND TYPE=command MSG="action:prompt_begin Confirm camera XY measurement"
    RESPOND TYPE=command MSG="action:prompt_text Camera connected: {tv.camera_connected} | Profile: {tv.camera_profile_ready} | Station: {tv.camera_station_ready} | Transform: {tv.camera_transform_ready}"
    RESPOND TYPE=command MSG="action:prompt_text Full G28 before run | Nozzle: {tv.calibration_temperature|round(1)} C | Bed: {bed_text} | Estimate: {estimate}"
    RESPOND TYPE=command MSG="action:prompt_text Report only - candidate XY relative to T{tv.reference_tool}; no offset will be applied"
    RESPOND TYPE=command MSG="action:prompt_footer_button Start measurement|_TOOL_VISION_UI_RUN ACTION=CALIBRATE_XY|error"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CONFIRM_Z_SWITCH]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set bed = tv.bed %}
    {% set bed_text = ((bed.actual_c|round(1)) ~ '/' ~ (bed.target_c|round(1)) ~ ' C - ' ~ bed.stability) if bed.available else 'unavailable' %}
    RESPOND TYPE=command MSG="action:prompt_begin Confirm Z - Physical switch"
    RESPOND TYPE=command MSG="action:prompt_text Sensor: Physical switch - {('Ready' if tv.switch_ready else 'Needs setup')} | Full G28 before run"
    RESPOND TYPE=command MSG="action:prompt_text Nozzle: {tv.calibration_temperature|round(1)} C | Bed: {bed_text} | Estimate: {(((tv.last_duration_seconds / 60.0)|round(1)) ~ ' min from latest run') if tv.last_result_mode == 'Z' and tv.last_result_method == 'switch' and tv.last_duration_seconds else 'no comparable run yet'}"
    RESPOND TYPE=command MSG="action:prompt_text Report only - candidate Z values relative to T{tv.reference_tool}; not deltas to add. No printer offsets will be applied"
    RESPOND TYPE=command MSG="action:prompt_footer_button Start measurement|_TOOL_VISION_UI_RUN ACTION=CALIBRATE_Z_SWITCH|error"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

