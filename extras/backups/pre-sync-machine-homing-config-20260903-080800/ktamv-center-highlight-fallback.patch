+    def find_center_highlight_keypoint(self, frame):
+        """Return the compact nozzle highlight nearest the image center.
+
+        The camera's supplied/default nozzle illumination is the optical input.
+        With the toolhead LEDs disabled, its stable white reflection is a more
+        reliable tracking feature than the super-relaxed blob detector.  An
+        external ESP32/WS2812B ring is not required or controlled.  The bounds
+        deliberately reject tiny sparkles, large overexposed regions, elongated
+        reflections, and candidates outside the calibration area.
+        """
+        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+        _, mask = cv2.threshold(gray, 245, 255, cv2.THRESH_BINARY)
+        count, _, stats, centroids = cv2.connectedComponentsWithStats(mask, 8)
+        target_point = np.array([320, 240])
+        candidates = []
+
+        for index in range(1, count):
+            area = int(stats[index, cv2.CC_STAT_AREA])
+            width = int(stats[index, cv2.CC_STAT_WIDTH])
+            height = int(stats[index, cv2.CC_STAT_HEIGHT])
+            if height == 0:
+                continue
+
+            aspect_ratio = width / float(height)
+            point = centroids[index]
+            distance = np.linalg.norm(point - target_point)
+            if (
+                30 <= area <= 1200
+                and 0.35 <= aspect_ratio <= 2.8
+                and distance <= 120
+            ):
+                candidates.append((distance, -area, point, width, height))
+
+        if not candidates:
+            return None
+
+        _, _, point, width, height = min(
+            candidates, key=lambda item: (item[0], item[1])
+        )
+        return cv2.KeyPoint(
+            float(point[0]), float(point[1]), float(max(width, height))
+        )
+
