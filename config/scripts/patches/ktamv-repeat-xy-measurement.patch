+    cmd_MEASURE_TOOL_XY_help = (
+        "Center the active tool repeatedly and report the mean XY residual"
+    )
+
+    def cmd_MEASURE_TOOL_XY(self, gcmd):
+        if not self.is_calibrated:
+            raise self.gcode.error("Camera is not calibrated, aborting")
+        if self.cp is None:
+            raise self.gcode.error(
+                "No center position set; center T0 and run KTAMV_SET_ORIGIN first"
+            )
+
+        samples = gcmd.get_int(
+            "SAMPLES", self.measurement_samples, minval=1, maxval=10
+        )
+        safe_z = gcmd.get_float("Z", self.measurement_z)
+        max_spread = gcmd.get_float(
+            "MAX_SPREAD", self.measurement_max_spread, minval=0.0
+        )
+
+        self.pm.ensureHomed()
+        toolchanger = self.printer.lookup_object("toolchanger", None)
+        tool_number = None
+        if toolchanger is not None:
+            tool_status = toolchanger.get_status(self.reactor.monotonic())
+            tool_number = tool_status.get("tool_number")
+            if tool_status.get("status") != "ready":
+                raise self.gcode.error("Toolchanger is not ready")
+            if tool_number is None or int(tool_number) < 0:
+                raise self.gcode.error("No active tool is selected")
+            if (
+                tool_status.get("detected_tool_number") is not None
+                and int(tool_status["detected_tool_number"]) != int(tool_number)
+            ):
+                raise self.gcode.error(
+                    "Detected tool does not match the active tool"
+                )
+
+        self.last_offset_samples = []
+        self.last_offset_average = None
+        self.last_offset_spread = None
+        self.last_measured_tool_number = tool_number
+
+        current = self.pm.get_gcode_position()
+        self.pm.moveAbsoluteToArray(
+            [current[0], current[1], safe_z], self.speed
+        )
+
+        for sample_index in range(samples):
+            # Returning to the same G-code origin makes every sample an
+            # independent correction against the offsets already loaded by KTC.
+            self.pm.moveAbsoluteToArray([self.cp[0], self.cp[1], safe_z], self.speed)
+            self.last_nozzle_center_successful = False
+            self._calibrate_nozzle(gcmd)
+            if not self.last_nozzle_center_successful:
+                raise self.gcode.error(
+                    "Nozzle centering failed during sample %d" % (sample_index + 1)
+                )
+
+            position = self.pm.get_raw_position()
+            offset = [
+                round(float(position[0]) - self.cp[0], 3),
+                round(float(position[1]) - self.cp[1], 3),
+            ]
+            self.last_offset_samples.append(offset)
+            gcmd.respond_info(
+                "kTAMV XY sample %d/%d: X:%+.3f Y:%+.3f"
+                % (sample_index + 1, samples, offset[0], offset[1])
+            )
+
+        x_values = [sample[0] for sample in self.last_offset_samples]
+        y_values = [sample[1] for sample in self.last_offset_samples]
+        self.last_offset_average = [
+            round(mean(x_values), 3),
+            round(mean(y_values), 3),
+        ]
+        self.last_offset_spread = [
+            round(max(x_values) - min(x_values), 3),
+            round(max(y_values) - min(y_values), 3),
+        ]
+
+        gcmd.respond_info(
+            "kTAMV XY result: tool=%s samples=%d mean_x=%+.3f mean_y=%+.3f "
+            "spread_x=%.3f spread_y=%.3f"
+            % (
+                str(tool_number),
+                samples,
+                self.last_offset_average[0],
+                self.last_offset_average[1],
+                self.last_offset_spread[0],
+                self.last_offset_spread[1],
+            )
+        )
+
+        if (
+            self.last_offset_spread[0] > max_spread
+            or self.last_offset_spread[1] > max_spread
+        ):
+            raise self.gcode.error(
+                "kTAMV XY spread exceeds %.3f mm; do not apply this result"
+                % max_spread
+            )
