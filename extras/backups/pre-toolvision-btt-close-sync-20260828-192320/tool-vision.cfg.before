[gcode_macro _TOOL_VISION_UI_CONFIRM_XYZ_CARTOGRAPHER]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set bed = tv.bed %}
    {% set bed_text = ((bed.actual_c|round(1)) ~ '/' ~ (bed.target_c|round(1)) ~ ' C - ' ~ bed.stability) if bed.available else 'unavailable' %}
    RESPOND TYPE=command MSG="action:prompt_begin Confirm XYZ - Camera + Cartographer Touch"
    RESPOND TYPE=command MSG="action:prompt_text Camera: {('Ready' if tv.camera_ready else 'Needs setup')} | Z: Cartographer Touch - {('Ready' if tv.cartographer_touch_ready else 'Needs setup')} | Full G28 before run"
    RESPOND TYPE=command MSG="action:prompt_text Nozzle: {tv.calibration_temperature|round(1)} C | Bed: {bed_text} | Estimate: {(((tv.last_duration_seconds / 60.0)|round(1)) ~ ' min from latest run') if tv.last_result_mode == 'XYZ' and tv.last_result_method == 'cartographer_touch' and tv.last_duration_seconds else 'no comparable run yet'}"
    RESPOND TYPE=command MSG="action:prompt_text Report only - candidate XYZ relative to T{tv.reference_tool}; no offset will be applied"
    RESPOND TYPE=command MSG="action:prompt_footer_button Start measurement|_TOOL_VISION_UI_RUN ACTION=CALIBRATE_XYZ_CARTOGRAPHER|error"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_RESULTS]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set mode = tv.last_result_mode|default('', true)|upper %}
    {% set method = "Physical switch" if tv.last_result_method == "switch" else ("Cartographer Touch" if tv.last_result_method == "cartographer_touch" else "Camera XY") %}
    {% set verdict = "Valid" if tv.last_session_status == "PASS" else ("Needs review" if tv.last_session_status == "WARNING" else "Invalid") %}
    {% set comparison = tv.last_production_comparison %}
    {% set environment = tv.last_environment %}
    RESPOND TYPE=command MSG="action:prompt_begin ToolVision latest results"
    {% if tv.last_result_mode %}
      RESPOND TYPE=command MSG="action:prompt_text Measurement: {verdict} | Mode: {mode} | Method: {method} | NOT APPLIED"
      RESPOND TYPE=command MSG="action:prompt_text T{tv.reference_tool} drift XY: {(('%.4f'|format(tv.reference_xy_drift)) ~ ' mm') if tv.reference_xy_drift is not none else 'n/a'} | Z: {(('%+.4f'|format(tv.reference_z_drift)) ~ ' mm') if tv.reference_z_drift is not none else 'n/a'} | Production comparison: {comparison.assessment|default('NOT_EVALUATED')}"
      {% if environment.bed is defined and environment.bed.end is defined %}
        RESPOND TYPE=command MSG="action:prompt_text Bed end: {environment.bed.end.actual_c|default('n/a')} / {environment.bed.end.target_c|default('n/a')} C - {environment.bed.end.stability|default('unknown')} | Nozzle request: {environment.nozzle.requested_c|default('n/a')} C"
      {% endif %}
      {% for number in tv.result_tool_numbers %}
        {% set result = tv.results.get(number|string) %}
        {% set compare = comparison.tools.get(number|string, {}) if comparison.tools is defined else {} %}
        {% set current = compare.get('configured_relative', {}) %}
        {% set difference = compare.get('difference', {}) %}
        {% if result %}
          {% if mode == "Z" %}
            RESPOND TYPE=command MSG="action:prompt_text T{number} | Z {('%+.4f'|format(result.z)) if result.z is defined else '-'} | Current {('%+.4f'|format(current.z)) if current.z is defined else '-'} | Diff {('%+.4f'|format(difference.z)) if difference.z is defined else '-'} | Not evaluated"
          {% elif mode == "XY" %}
            RESPOND TYPE=command MSG="action:prompt_text T{number} | XY {('%+.4f'|format(result.x)) if result.x is defined else '-'}/{('%+.4f'|format(result.y)) if result.y is defined else '-'} | Current {('%+.4f'|format(current.x)) if current.x is defined else '-'}/{('%+.4f'|format(current.y)) if current.y is defined else '-'} | Diff {('%+.4f'|format(difference.x)) if difference.x is defined else '-'}/{('%+.4f'|format(difference.y)) if difference.y is defined else '-'}"
          {% else %}
            RESPOND TYPE=command MSG="action:prompt_text T{number} | dX {('%+.4f'|format(result.x)) if result.x is defined else '-'} | dY {('%+.4f'|format(result.y)) if result.y is defined else '-'} | dZ {('%+.4f'|format(result.z)) if result.z is defined else '-'} | {compare.assessment|default('NOT_EVALUATED')}"
          {% endif %}
        {% endif %}
      {% endfor %}
      {% if tv.result_tool_numbers|length == 0 %}
        RESPOND TYPE=command MSG="action:prompt_text No tool measurement completed; review the INVALID session in console/history."
      {% endif %}
    {% else %}
      RESPOND TYPE=command MSG="action:prompt_text No persisted ToolVision result is available."
    {% endif %}
    RESPOND TYPE=command MSG="action:prompt_button Console report/history|_TOOL_VISION_UI_RUN ACTION=HISTORY|info"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_SETUP]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin ToolVision setup"
    RESPOND TYPE=command MSG="action:prompt_text Teach stations with T{tv.reference_tool} mounted. Current pilot support requires its configured XYZ offset to be zero; non-zero reference teaching still awaits R-002 HIL."
    RESPOND TYPE=command MSG="action:prompt_button Camera XY setup|_TOOL_VISION_UI_CAMERA_SETUP|primary"
    RESPOND TYPE=command MSG="action:prompt_button Sensor setup|_TOOL_VISION_UI_Z_SETUP|warning"
    RESPOND TYPE=command MSG="action:prompt_button Readiness status|_TOOL_VISION_UI_SETUP_STATUS|info"
    RESPOND TYPE=command MSG="action:prompt_button Advanced|_TOOL_VISION_UI_ADVANCED|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CAMERA_SETUP]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin Camera XY setup"
    RESPOND TYPE=command MSG="action:prompt_text Connected: {tv.camera_connected} | Selection: {tv.camera_selection|default('automatic', true)} | Station: {tv.camera_station_ready} | Profile: {tv.camera_profile_ready} | Transform: {tv.camera_transform_ready}"
    RESPOND TYPE=command MSG="action:prompt_button Discover/Refresh cameras|_TOOL_VISION_UI_RUN ACTION=CAMERA_DISCOVER|info"
    {% if tv.camera_candidates|length > 1 %}
      RESPOND TYPE=command MSG="action:prompt_button Choose camera|_TOOL_VISION_UI_CAMERA_SELECT|primary"
    {% endif %}
    RESPOND TYPE=command MSG="action:prompt_button Preview/Refresh frame|_TOOL_VISION_UI_RUN ACTION=CAMERA_PREVIEW|info"
    RESPOND TYPE=command MSG="action:prompt_button Save current T0 camera position|_TOOL_VISION_UI_CONFIRM_CAMERA_STATION|warning"
    RESPOND TYPE=command MSG="action:prompt_button Learn nozzle + transform|_TOOL_VISION_UI_CONFIRM_CAMERA_LEARN|warning"
    RESPOND TYPE=command MSG="action:prompt_button Test camera XY with T0|_TOOL_VISION_UI_RUN ACTION=CAMERA_TEST|primary"
    RESPOND TYPE=command MSG="action:prompt_text Preview uses native resolution. Adjust physical focus/light in the frontend Webcam view; ToolVision does not ask for a universal sharpness threshold."
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CAMERA_SELECT]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin Choose camera"
    RESPOND TYPE=command MSG="action:prompt_text Selecting a different optical source marks its learned profile/transform not ready. URLs are never shown or stored here."
    {% for camera in tv.camera_candidates %}
      RESPOND TYPE=command MSG="action:prompt_button {camera.name} - {camera.location}|_TOOL_VISION_UI_RUN ACTION=CAMERA_SELECT INDEX={loop.index0}|primary"
    {% endfor %}
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_CAMERA_SETUP|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_Z_SETUP]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
