[gcode_macro _CLIENT_VARIABLE]
variable_user_pause_macro = "_SET_LED_STATUS_PAUSE"
variable_user_resume_macro = "_LED_RESUME_WRAPPER"
variable_user_cancel_macro = "_CUSTOM_CANCEL_CLEANUP"
gcode = 

[gcode_macro _CUSTOM_CANCEL_CLEANUP]
description = Dọn dẹp toolchanger + LED khi huỷ in (hook mainsail CANCEL_PRINT)
gcode = 
	
	M220 S100
	M221 S100
	SET_PRESSURE_ADVANCE ADVANCE=0
	{% if printer["gcode_macro STOP_CRASH_DETECTION"] is defined %}
	STOP_CRASH_DETECTION
	{% endif %}
	
	
	{% if "xyz" in printer.toolhead.homed_axes %}
	{% set th = printer.toolhead %}
	
	
	{% set z_now  = th.position.z|float %}
	{% set z_safe = [[z_now + 10.0, 50.0]|max, th.axis_maximum.z|float]|min %}
	G90
	G0 Z{z_safe} F3000
	
	
	
	{% if printer.toolchanger.tool_number|default(-1)|int != 0 %}
	T0
	{% endif %}
	
	
	G90
	G0 X{th.axis_maximum.x // 2} Y{th.axis_maximum.y - 2} F9000
	
	{% else %}
	
	RESPOND TYPE=echo MSG="[CANCEL] Chua home XYZ - bo qua park/toolchange"
	{% endif %}
	
	
	{% for tn in printer.toolchanger.tool_numbers %}
	{% set fan_name = "T" ~ tn|string ~ "_part_fan" %}
	{% if ("fan_generic " ~ fan_name) in printer %}
	SET_FAN_SPEED FAN={fan_name} SPEED=0
	{% endif %}
	{% set ext_name = "extruder" if tn == 0 else "extruder" ~ tn|string %}
	SET_STEPPER_ENABLE STEPPER={ext_name} ENABLE=0
	{% endfor %}
	
	
	BED_MESH_CLEAR
	CLEAR_PAUSE
	SET_GCODE_OFFSET X=0 Y=0 Z=0
	
	
	SET_GCODE_VARIABLE MACRO=_PRINT_STATE VARIABLE=state VALUE="'idle'"
	_ALL_TOOLHEADS_LED_SET STATE=standby
	M117 In đã huỷ.

[resonance_tester]
accel_chip = adxl345 T1
probe_points = 180, 168, 20
sweeping_accel = 400
sweeping_period = 0

[shaketune]
result_folder = ~/printer_data/config/ShakeTune_results
number_of_results_to_keep = 5
keep_raw_data = False
show_macros_in_webui = True
timeout = 900
max_freq = 150
dpi = 150

[gcode_arcs]
resolution = 0.1

[gcode_macro CLEAN_NOZZLE]
description = Vệ sinh nozzle
gcode = 
	
	{% set wipes      = params.WIPES|default(5)|int %}
	{% set clean_temp = params.TEMP|default(150)|int %}
	{% set purge_mm   = params.PURGE|default(0)|int %}
	{% set purge_t    = params.PURGE_TEMP|default(0)|int %}
	
	
	{% set bucket_x      = 320.0 %}
	{% set brush_cy      =  -8.0 %}
	{% set flick_x       = 307.0 %}
	{% set scrub_start_x = 279.5 %}
	{% set scrub_width   =  31.0 %}
	{% set circle_r      =   2.0 %}
	{% set clean_z       =   2.0 %}
	{% set safe_z        =  15.0 %}
	
	
	{% set ns = namespace(step=0.0) %}
	{% if wipes > 1 %}
	{% set ns.step = scrub_width / (wipes - 1) %}
	{% endif %}
	
	
	{% set travel_f = 9000 %}
	{% set z_f      = 1500 %}
	{% set flick_f  = 9000 %}
	{% set snap_f   = 13500 %}
	{% set scrub_f  = 3000 %}
	
	
	{% set extruder = printer.toolhead.extruder %}
	
	SAVE_GCODE_STATE NAME=clean_nozzle_state
	G90
	
	
	{% if "xyz" not in printer.toolhead.homed_axes %}
	_SET_LED_STATUS_LEVELING
	G28
	{% endif %}
	
	
	
	
	_SET_LED_STATUS_CLEANING
	M117 Di chuyển đến bucket...
	G1 Z{[printer.toolhead.position[2], safe_z]|max} F{z_f}
	G1 X{bucket_x} Y{brush_cy} F{travel_f}
	
	
	
	
	
	
	{% if purge_mm > 0 %}
	{% set actual_pt = [purge_t, clean_temp, 200]|max %}
	M117 Nung {actual_pt}°C để xả nhựa cũ...
	M104 S{actual_pt}
	M109 S{actual_pt}
	M117 Xả {purge_mm}mm vào bucket...
	M83
	G1 E{purge_mm} F300
	G1 E-2 F2100
	M82
	M117 Hạ về {clean_temp}°C (quạt tối đa)...
	M104 S{clean_temp}
	M106 S255
	TEMPERATURE_WAIT SENSOR={extruder} MAXIMUM={clean_temp}
	M107
	G4 P2000
	
	
	
	
	{% else %}
	{% if printer[extruder].temperature < clean_temp - 5 %}
	M117 Nung nozzle {clean_temp}°C...
	M104 S{clean_temp}
	M109 S{clean_temp}
	{% endif %}
	{% endif %}
	
	
	
	
	G1 Z{clean_z} F{z_f}
	
	
	
	
	
	M117 Flick {wipes}x...
	{% for i in range(wipes) %}
	G1 Z{clean_z - 0.5} F{z_f}
	G1 X{flick_x} F{flick_f}
	G4 P20
	G1 X{bucket_x} F{snap_f}
	G1 Z{clean_z} F{z_f}
	{% endfor %}
	
	
	
	
	
	M117 Circular scrub {wipes} pass...
	{% for i in range(wipes) %}
	{% set x_pos = scrub_start_x + (i * ns.step) %}
	G1 X{x_pos} Y{brush_cy} F{travel_f}
	G2 X{x_pos} Y{brush_cy} I{circle_r} J0 F{scrub_f}
	G3 X{x_pos} Y{brush_cy} I{circle_r} J0 F{scrub_f}
	{% endfor %}
	
	
	
	
	G1 X{bucket_x} F{travel_f}
	G1 Z{safe_z} F{z_f}
	M117 Nozzle sạch — sẵn sàng probe
	
	_SET_LED_STATUS_READY
	RESTORE_GCODE_STATE NAME=clean_nozzle_state

[gcode_macro _CLEAN_NOZZLE_PARK]
description = Park nozzle vào bucket an toàn
gcode = 
	{% set safe_z = 10 %}
	G90
	{% if "xyz" not in printer.toolhead.homed_axes %}
	_SET_LED_STATUS_LEVELING
	G28
	{% endif %}
	G0 Z{safe_z} F3000
	G0 X320 Y-8 F9000
	M117 Nozzle parked tại bucket

[gcode_macro PURGE_AND_CLEAN]
description = Xả nhựa cũ + vệ sinh nozzle (purge → hạ nhiệt → flick → scrub)
gcode = 
	{% set purge_mm   = params.PURGE|default(15)|int %}
	{% set purge_temp = params.PURGE_TEMP|default(200)|int %}
	{% set clean_temp = params.TEMP|default(150)|int %}
	{% set wipes      = params.WIPES|default(5)|int %}
	
	_SET_LED_STATUS_CLEANING
	CLEAN_NOZZLE TEMP={clean_temp} WIPES={wipes} PURGE={purge_mm} PURGE_TEMP={purge_temp}
	_SET_LED_STATUS_READY

[idle_timeout]
timeout = 1800

[exclude_object]

[gcode_macro G32]
description = Home toàn bộ + cân bằng gantry
gcode = 
	_SET_LED_STATUS_LEVELING
	BED_MESH_CLEAR
	G28
	QUAD_GANTRY_LEVEL
	
	G0 X180 Y180 Z30 F3600
	_SET_LED_STATUS_READY

[gcode_macro QUAD_GANTRY_LEVEL]
description = Cân bằng gantry (QGL)
rename_existing = _QUAD_GANTRY_LEVEL
gcode = 
	_SET_LED_STATUS_LEVELING
	SAVE_GCODE_STATE NAME=STATE_QGL
	BED_MESH_CLEAR
	{% if "xyz" not in printer.toolhead.homed_axes %}
	G28
	{% endif %}
	{% if not printer.quad_gantry_level.applied %}
	_QUAD_GANTRY_LEVEL horizontal_move_z=10 retry_tolerance=1
	{% endif %}
	_QUAD_GANTRY_LEVEL horizontal_move_z=2
	G28 Z
	RESTORE_GCODE_STATE NAME=STATE_QGL
	_SET_LED_STATUS_READY

[quad_gantry_level]
gantry_corners = 
	-10, -10
	353, 350
points = 
	20, 0
	20, 280
	330, 280
	330, 0
speed = 200
horizontal_move_z = 10
retries = 5
retry_tolerance = 0.0050
max_adjust = 10

[gcode_macro _PRIME_LINE]
description = Vẽ đường prime
gcode = 
	{% set prime_length   = 150 %}
	{% set prime_x_start  = 100 %}
	{% set prime_y        = 0 %}
	{% set prime_z        = 0.28 %}
	{% set prime_extrude  = 25 %}
	{% set prime_feedrate = 1200 %}
	{% if "xyz" not in printer.toolhead.homed_axes %}
	RESPOND TYPE=error MSG="_PRIME_LINE can XYZ homed; bo qua prime de tranh move sai toa do"
	{% else %}
	G90
	G92 E0
	G0 Z5 F3000
	G0 X{prime_x_start} Y{prime_y} F6000
	G0 Z{prime_z} F300
	G1 X{prime_x_start + prime_length} Y{prime_y} E{prime_extrude} F{prime_feedrate}
	G92 E0
	G1 Z2.0 F3000
	G1 X{prime_x_start + prime_length + 10} F6000
	
	G1 E-0.5 F3600
	G92 E0
	{% endif %}

[gcode_macro _PRINT_START_SELECT_T0]
description = Select T0 during PRINT_START after full homing
gcode = 
	{% if printer.toolchanger.tool_number|default(-1)|int != 0 %}
	M117 Gan T0 sau full home
	T0
	{% endif %}

[gcode_macro PRINT_START]
description = Bat dau in - safe homing first cho StealthChanger
gcode = 
	{% set TOOL       = params.TOOL|default(0)|int %}
	{% set TOOL_TEMP  = params.TOOL_TEMP|default(0)|int %}
	{% set BED_TEMP   = params.BED_TEMP|default(0)|int %}
	{% set SOAK_TIME  = params.SOAK|default(0)|int %}
	{% set PROBE_TEMP = 150 %}
	{% set SAFE_Z     = 10 %}
	{% set START_TEMP_KEY = "T" ~ TOOL ~ "_TEMP" %}
	{% set START_TOOL_TEMP = params[START_TEMP_KEY]|int if START_TEMP_KEY in params else TOOL_TEMP %}
	{% set FIRST_TOOL_STANDBY = [START_TOOL_TEMP, 170]|min %}
	{% set bed_start = printer.heater_bed.temperature|default(0)|float %}
	
	{% if TOOL not in printer.toolchanger.tool_numbers %}
	RESPOND TYPE=error MSG="PRINT_START sai TOOL={TOOL}; tool khong ton tai"
	CANCEL_PRINT
	{% elif START_TOOL_TEMP <= 0 or BED_TEMP <= 0 %}
	RESPOND TYPE=error MSG="PRINT_START thieu nhiet: T{TOOL}={START_TOOL_TEMP} BED={BED_TEMP}; kiem tra Orca Start G-code"
	CANCEL_PRINT
	{% else %}
	
	
	CLEAR_PAUSE
	BED_MESH_CLEAR
	SET_GCODE_OFFSET X=0 Y=0 Z=0
	G90
	M83
	INITIALIZE_TOOLCHANGER
	SET_GCODE_VARIABLE MACRO=_PRINT_STATE VARIABLE=state VALUE="'starting'"
	{% if printer["gcode_macro STOP_CRASH_DETECTION"] is defined %}
	STOP_CRASH_DETECTION
	{% endif %}
	_SET_LED_STATUS_LEVELING
	
	
	
	
	_SET_LED_STATUS_HEATING
	M117 Heat async bed/T0/T{TOOL}
	M140 S{BED_TEMP}
	{% for tn in printer.toolchanger.tool_numbers %}
	{% if tn == 0 %}
	M104 T0 S{PROBE_TEMP}
	{% elif tn == TOOL %}
	M104 T{tn} S{FIRST_TOOL_STANDBY}
	{% else %}
	M104 T{tn} S0
	{% endif %}
	{% endfor %}
	
	_SET_LED_STATUS_LEVELING
	M117 Full G28 bang Cartographer shuttle
	
	
	G28
	G90
	G0 Z{SAFE_Z} F3000
	
	
	_PRINT_START_SELECT_T0
	G90
	G0 Z{SAFE_Z} F3000
	_CLEAN_NOZZLE_PARK
	
	
	{% if bed_start < BED_TEMP %}
	M117 Nung ban {BED_TEMP}C
	M190 S{BED_TEMP}
	{% else %}
	M117 Ban da du nhiet
	RESPOND TYPE=echo MSG="Bed {bed_start|int}C >= target {BED_TEMP}C; khong cho nguoi"
	{% endif %}
	BED_FAN_ON SPEED=0.5
	
	{% if SOAK_TIME > 0 %}
	M117 Ngam nhiet {SOAK_TIME}s
	G4 P{SOAK_TIME * 1000}
	{% elif BED_TEMP >= 90 and (BED_TEMP - bed_start) > 10 %}
	M117 Ngam nhiet 100s
	G4 P100000
	{% endif %}
	
	
	{% if TOOL != 0 %}
	M104 T{TOOL} S{START_TOOL_TEMP}
	{% endif %}
	
	
	_SET_LED_STATUS_CLEANING
	M117 Clean T0
	M109 T0 S{PROBE_TEMP}
	CLEAN_NOZZLE TEMP={PROBE_TEMP} WIPES=5
	
	_SET_LED_STATUS_LEVELING
	M117 Re-home Z sau clean
	G28 Z
	G0 Z{SAFE_Z} F3000
	
	
	{% if TOOL != 0 %}
	M104 T{TOOL} S{START_TOOL_TEMP}
	{% endif %}
	
	M117 QGL
	QUAD_GANTRY_LEVEL
	G0 Z{SAFE_Z} F3000
	
	
	M104 T0 S{PROBE_TEMP}
	M109 T0 S{PROBE_TEMP}
	M117 Cartographer touch home
	CARTOGRAPHER_TOUCH_HOME
	G0 Z{SAFE_Z} F3000
	
	
	{% if TOOL != 0 %}
	{% if "T0_TEMP" in params and params.T0_TEMP|int > 0 %}
	M104 T0 S{PROBE_TEMP}
	{% else %}
	M104 T0 S0
	{% endif %}
	M117 Gan T{TOOL}
	T{TOOL}
	{% endif %}
	
	
	_SET_LED_STATUS_HEATING
	M117 Nung T{TOOL} {START_TOOL_TEMP}C
	M104 T{TOOL} S{START_TOOL_TEMP}
	
	_SET_LED_STATUS_LEVELING
	M117 Bed mesh adaptive
	BED_MESH_CALIBRATE ADAPTIVE=1
	M400
	
	_SET_LED_STATUS_HEATING
	M117 Cho T{TOOL} {START_TOOL_TEMP}C
	M109 T{TOOL} S{START_TOOL_TEMP}
	G4 P5000
	
	
	M117 Prime line
	_PRIME_LINE
	{% if printer["gcode_macro START_CRASH_DETECTION"] is defined %}
	START_CRASH_DETECTION
	{% endif %}
	SET_GCODE_VARIABLE MACRO=_PRINT_STATE VARIABLE=state VALUE="'printing'"
	_SET_LED_STATUS_PRINTING
	M117 Dang in
	
	{% endif %}

[gcode_macro PRINT_END]
description = Kết thúc in
gcode = 
	
	SET_GCODE_VARIABLE MACRO=_PRINT_STATE VARIABLE=state VALUE="'idle'"
	
	
	{% set th = printer.toolhead %}
	
	
	{% set z_safe = [[th.position.z + 10, 50]|max, th.axis_maximum.z]|min %}
	
	
	M220 S100
	M221 S100
	SET_PRESSURE_ADVANCE ADVANCE=0
	{% if printer["gcode_macro STOP_CRASH_DETECTION"] is defined %}
	STOP_CRASH_DETECTION
	{% endif %}
	
	{% set xyz_homed = "xyz" in th.homed_axes %}
	{% if xyz_homed %}
	
	
	
	
	
	
	{% if printer[printer.toolhead.extruder].can_extrude %}
	G92 E0
	G91
	G1 E-2.0 F2700
	G1 Z5 E-8.0 F12000
	G90
	{% endif %}
	M400
	
	
	
	G90
	G0 Z{z_safe} F3000
	
	
	
	
	
	{% for tn in printer.toolchanger.tool_numbers %}
	M104 S0 T{tn}
	{% endfor %}
	
	{% if printer.toolchanger.tool_number|default(-1)|int != 0 %}
	T0
	{% endif %}
	
	
	
	G0 X{th.axis_maximum.x//2} Y{th.axis_maximum.y - 2} F9000
	{% else %}
	RESPOND TYPE=echo MSG="[PRINT_END] Chua home XYZ - bo qua retract/Z-hop/toolchange/park"
	{% endif %}
	
	
	SET_GCODE_OFFSET X=0.0 Y=0.0 Z=0.0
	
	
	{% for tn in printer.toolchanger.tool_numbers %}
	M104 S0 T{tn}
	{% set fan_section = "fan_generic T" ~ tn|string ~ "_part_fan" %}
	{% if fan_section in printer.configfile.config %}
	SET_FAN_SPEED FAN=T{tn}_part_fan SPEED=0
	{% endif %}
	{% set ext_name = "extruder" if tn == 0 else "extruder" ~ tn|string %}
	SET_STEPPER_ENABLE STEPPER={ext_name} ENABLE=0
	{% endfor %}
	M140 S0
	
	
	UPDATE_DELAYED_GCODE ID=bed_fan_off_delay DURATION=180
	
	
	BED_MESH_CLEAR
	CLEAR_PAUSE
	
	
	_SET_LED_STATUS_COMPLETE
	M117 Hoàn tất

[gcode_macro _FILAMENT_RUNOUT_HANDLE]
description = Xử lý hết nhựa (debounce)
gcode = 
	{% set T = params.T|int %}
	{% set sensor_name = "filament_sensor_T" ~ T %}
	
	{% if not printer["filament_switch_sensor " ~ sensor_name].filament_detected %}
	
	
	
	
	{% set active_tool_number = printer.toolchanger.tool_number|default(-1)|int %}
	
	{% if active_tool_number == T %}
	RESPOND PREFIX="⚠️ HẾT NHỰA" MSG="T{T}: xác nhận sau debounce — đang dừng in"
	_FILAMENT_RUNOUT_PAUSE T={T}
	{% else %}
	RESPOND PREFIX="⚠️ CẢNH BÁO" MSG="T{T}: hết nhựa (parked) — tool đang in là T{active_tool_number} — không dừng"
	{% endif %}
	
	{% else %}
	RESPOND MSG="[T{T}] Nhiễu lọc thành công — cảm biến bình thường"
	{% endif %}

[gcode_macro _FILAMENT_RUNOUT_PAUSE]
description = Tạm dừng khi hết nhựa
gcode = 
	{% set T = params.T|int %}
