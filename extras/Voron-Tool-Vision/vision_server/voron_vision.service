[Unit]
Description=Voron Tool Vision - Camera Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/printer_data/config/Voron 5 Tool/extras/Voron-Tool-Vision/vision_server
ExecStart=/home/pi/voron-vision-env/bin/python vtv_server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
