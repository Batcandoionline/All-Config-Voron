  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin Z sensor setup"
    RESPOND TYPE=command MSG="action:prompt_text Physical switch: {('Ready' if tv.switch_ready else 'Needs setup')} | Cartographer Touch: {('Ready' if tv.cartographer_touch_ready else 'Needs setup')}"
    RESPOND TYPE=command MSG="action:prompt_button Teach Physical switch|_TOOL_VISION_UI_CONFIRM_SWITCH|warning"
    RESPOND TYPE=command MSG="action:prompt_button Check Physical switch|_TOOL_VISION_UI_RUN ACTION=CHECK_SWITCH|info"
    RESPOND TYPE=command MSG="action:prompt_button Teach Cartographer Touch|_TOOL_VISION_UI_CONFIRM_CARTOGRAPHER|warning"
    RESPOND TYPE=command MSG="action:prompt_button Check Cartographer Touch|_TOOL_VISION_UI_RUN ACTION=CHECK_CARTOGRAPHER|info"
    RESPOND TYPE=command MSG="action:prompt_button Status|_TOOL_VISION_UI_SETUP_STATUS|info"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CONFIRM_CAMERA_STATION]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin Save camera position"
    RESPOND TYPE=command MSG="action:prompt_text Mount T{tv.reference_tool}, home XYZ, jog the clean nozzle near the camera image center and verify a collision-free vertical path. Saving invalidates old profile/transform readiness."
    RESPOND TYPE=command MSG="action:prompt_footer_button Save position|_TOOL_VISION_UI_RUN ACTION=CAMERA_STATION|warning"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CONFIRM_CAMERA_LEARN]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    RESPOND TYPE=command MSG="action:prompt_begin Learn camera XY"
    RESPOND TYPE=command MSG="action:prompt_text Requires a saved T{tv.reference_tool} camera station and clear room for the ten-point 0.5 mm kTAMV pattern. It learns the nozzle, fits/validates transform and centers T{tv.reference_tool}."
    RESPOND TYPE=command MSG="action:prompt_footer_button Learn + calibrate|_TOOL_VISION_UI_RUN ACTION=CAMERA_LEARN|warning"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_CAMERA_SETUP|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

[gcode_macro _TOOL_VISION_UI_CONFIRM_SWITCH]
gcode:
  {% set tv = printer.tool_vision %}
  {% set print_state = printer.print_stats.state|default('unknown')|lower %}
  RESPOND TYPE=command MSG="action:prompt_end"
  {% if print_state in ["printing", "paused"] %}
    RESPOND TYPE=echo MSG="ToolVision panel is unavailable while the printer is {print_state}."
  {% elif tv.busy %}
    RESPOND TYPE=echo MSG="ToolVision is busy; wait for the current operation or use Close."
  {% else %}
    {% set current = "Physical switch" if tv.z_method == "switch" else ("Cartographer Touch" if tv.z_method == "cartographer_touch" else "not selected") %}
    RESPOND TYPE=command MSG="action:prompt_begin Teach Physical switch"
    RESPOND TYPE=command MSG="action:prompt_text Current method -> New method: {current} -> Physical switch. Mount T{tv.reference_tool}, home XYZ, jog above an open switch and verify pin polarity plus a collision-free vertical path."
    RESPOND TYPE=command MSG="action:prompt_footer_button Teach switch|_TOOL_VISION_UI_RUN ACTION=SETUP_SWITCH|error"
    RESPOND TYPE=command MSG="action:prompt_footer_button Back|_TOOL_VISION_UI_MAIN|secondary"
    RESPOND TYPE=command MSG="action:prompt_footer_button Close|_TOOL_VISION_UI_CLOSE|secondary"
    RESPOND TYPE=command MSG="action:prompt_show"
  {% endif %}

